{
  "name": "agent-driven-architecture-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Functional TypeScript reference implementation of the Agent-Driven Architecture, on the Vercel AI SDK.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint && npm run biome && vitest run",
    "demo": "tsx src/app/main.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome": "biome check ."
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1.7.1",
    "ai": "^6.0.208",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  }
}
